# ── Cloudflare auth (bắt buộc) ──────────────────────────────────────────────
# Khuyến nghị dùng API Token có quyền giới hạn thay vì Global API Key.
# Để lấy được log truy vấn DNS (npm run dns-logs), token cần thêm quyền
# "Account Analytics: Read" — không chỉ quyền Zero Trust/Gateway thông thường.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Chỉ dùng nếu không có API Token:
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_EMAIL=

# ── Tuỳ chọn ─────────────────────────────────────────────────────────────
# Giới hạn số domain tối đa (mặc định 300000, giới hạn của gói Free)
# CLOUDFLARE_LIST_ITEM_LIMIT=300000

# Chạy thử, không ghi thay đổi lên Cloudflare
# DRY_RUN=1

# Bật để cho phép các script xoá (teardown)
# CGPS_DELETION_ENABLED=true

# Hiện trang chặn khi truy cập domain bị chặn
# BLOCK_PAGE_ENABLED=1

# Chặn thêm theo SNI (chỉ có tác dụng nếu traffic đi qua Cloudflare proxy)
# BLOCK_BASED_ON_SNI=1

# Danh sách nguồn tuỳ chỉnh (mỗi dòng một URL). Bỏ trống để dùng danh sách mặc định.
# ALLOWLIST_URLS=
# BLOCKLIST_URLS=

# Số giờ gần nhất để lấy log truy vấn DNS (mặc định 24)
# DNS_LOG_WINDOW_HOURS=24

# Webhook Discord (tuỳ chọn) để nhận thông báo mỗi lần chạy
# DISCORD_WEBHOOK_URL=

# ── Security Categories (tương đương "Threat Protection" của NextDNS) ──────
# Mặc định TẤT CẢ đều BẬT. Đặt "=0" để TẮT riêng từng cái.
# Xem src/core/security-categories.js để biết category nào map vào rule nào.
# BLOCK_MALWARE=0
# BLOCK_PHISHING=0
# BLOCK_CRYPTOJACKING=0
# BLOCK_DNS_REBINDING=0
# BLOCK_IDN_HOMOGRAPH=0
# BLOCK_TYPOSQUATTING=0
# BLOCK_DGA=0
# BLOCK_NEWLY_REGISTERED=0
# BLOCK_DNS_TUNNELING=0
# BLOCK_SPYWARE=0
# BLOCK_ANONYMIZER=0
# Lưu ý: CSAM luôn bị Cloudflare chặn cứng, không cấu hình được và không cần bật ở đây.
# Lưu ý: "Tên miền lưu trữ web miễn phí", "Tên miền đỏ", "TLD nguy hiểm" KHÔNG có
# category tương đương trên Gateway — cần tự đẩy domain list riêng (không nằm trong phần này).
